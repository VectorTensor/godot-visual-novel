#include "dialogueText.h"


void godot::dialogueText::_bind_methods() {
    ClassDB::bind_method(
                D_METHOD("set_dialogue_box", "label"),
                &dialogueText::set_dialogue_box
            );

    ClassDB::bind_method(
        D_METHOD("get_dialogue_box"),
        &dialogueText::get_dialogue_box
    );

    ClassDB::bind_method(
        D_METHOD("set_yaml_path", "path")
        );

    ADD_PROPERTY(
        PropertyInfo(Variant::OBJECT, "dialogue_box",
            PROPERTY_HINT_NODE_TYPE, "Label"),
        "set_dialogue_box",
        "get_dialogue_box"
    );}

void godot::dialogueText::_process(double delta) {

    current_delta += delta;
    if (current_delta >= speed && current_length <= max_length) {

        current_delta = 0;
        String subStr = sampleText.substr(0, current_length);
        current_length += 1;
        label->set_text(subStr);

    }


}

